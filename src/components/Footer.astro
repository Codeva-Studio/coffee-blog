
---

// Delimitamos el frontmatter para que Astro pueda procesar lógica y código JavaScript dentro de este archivo

// Obtenemos el año actual para mostrarlo dinámicamente en el pie de página
const currentYear = new Date().getFullYear();
---

<footer class="bg-espresso text-cream">
    <div class="mx-auto w-full max-w-6xl px-6 py-12">

        <!-- Contenido principal del footer -->
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-[2fr_1fr] sm:gap-16">

            <!-- Identidad de Coffee Blog -->
            <div class="flex max-w-xl flex-col gap-4">
                <a href="/" class="w-fit font-heading text-3xl font-semibold tracking-wide transition-colors hover:text-terracotta">Coffee Blog</a>
                <p class="max-w-lg text-sm leading-7 text-taupe">
                    Un espacio dedicado a los amantes del café. Descubre sus orígenes, variedades y métodos de preparación a través de artículos, guías y recomendaciones para disfrutar cada taza.
                </p>
            </div>

            <!-- Navegación principal -->
            <nav>
                <h2 class="mb-5 font-body text-xs font-bold uppercase tracking-widest text-cream">Explorar</h2>

                <ul class="flex flex-wrap gap-x-8 gap-y-3 text-sm text-taupe">
                    <li>
                        <a href="/" class="transition-colors hover:text-cream">Inicio</a>
                    </li>
                    <li>
                        <a href="/blog/" class="transition-colors hover:text-cream">Blog</a>
                    </li>
                </ul>
            </nav>

        </div>

        <!-- Franja inferior -->
        <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-cream/15 pt-6 text-xs text-taupe sm:flex-row sm:items-center">

            <p>© {currentYear} Coffee Blog. Todos los derechos reservados.</p>

            <p class="font-heading text-base italic text-terracotta">Una pasión que comienza en cada taza.</p>

        </div>

        <!-- Crédito de desarrollo -->
        <div class="mt-6 flex justify-center">
            <a href="https://codeva-studio.netlify.app/" target="_blank" rel="noopener noreferrer" class="font-body text-xs text-taupe">
                Desarrollado por <span class="font-semibold text-cream transition-colors hover:text-taupe">Codeva Studio</span>
            </a>
        </div>

    </div>
</footer>
